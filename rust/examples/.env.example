# Set only the selected flow's inputs. Keep real credentials in an untracked .env.
# Copy keygen's output into your untracked .env. It contains throwaway private keys.
# Ed25519 is a 64-byte keypair as hex. secp256* keys are 32-byte secrets as hex.
# SWIG_ED25519_PRIVATE_KEY=
# SWIG_SECP256K1_PRIVATE_KEY=
# SWIG_SECP256R1_PRIVATE_KEY=

# Shell variables override .env. Leave optional settings commented when unused.
SWIG_API_KEY=
# Hosted API is the default. Localhost is an explicit internal-testing override.
# SWIG_NETWORK=devnet
# SWIG_API_URL=

# Reads require an existing config. A supplied wallet address must match it.
# SWIG_CONFIG_ADDRESS=
# SWIG_WALLET_ADDRESS=

# RPC-backed flows require a valid HTTP(S) endpoint on the API's chain.
# Wallet reads need no RPC URL or private key.
SWIG_RPC_URL=
# A configured wallet must exist. Creation occurs only when config is absent.
# Use a separate recipient, not the requester, config, or wallet address.
# On Devnet, omission generates a recipient whose private key is not retained.
# Use your own recipient to recover transferred funds.
# SOL amount defaults to 0.001 SOL. Faucet requests are exactly 2 SOL.
# SWIG_DESTINATION=
# SWIG_AMOUNT_LAMPORTS=1000000

# Token transfers need funded tokens. Mainnet requires an explicit recipient.
# The default token amount is one raw unit.
# SWIG_TOKEN_MINT=
# SWIG_TOKEN_AMOUNT_RAW=

# Participant transfer uses Ed25519 and secp256r1 keys with software WebAuthn.
# The deployed backend and program must support ParticipantSet and this format.

# Swap inputs are already-held tokens, including wrapped SOL when selected.
# SWIG_SWAP_INPUT_MINT=
# SWIG_SWAP_OUTPUT_MINT=
# SWIG_SWAP_AMOUNT_RAW=

# Bundle sponsorship requires SWIG_NETWORK=mainnet and a funded signer.
