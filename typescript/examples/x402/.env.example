# Supply these in this file or load the same env file used by the Rust examples.
# SWIG_API_KEY=your-api-key
# SWIG_RPC_URL=https://api.devnet.solana.com
# SWIG_ED25519_PRIVATE_KEY=hex-encoded-64-byte-keypair
# SWIG_NETWORK=devnet

# Optional. Defaults to the hosted Swig API.
# SWIG_API_URL=https://api.onswig.com

# Legacy aliases SOLANA_RPC_URL and SWIG_BACKEND_URL are still accepted.
# If both a canonical variable and its alias are set, their values must match.

# --server-only requires SWIG_ED25519_PRIVATE_KEY shared with the Rust payer.
# The normal TypeScript flow can instead use X402_DEVELOPER_KEYPAIR below.
# If both developer key variables are set, they must describe the same keypair.
# Setup remembers generated identities; explicitly supplied keys are not saved.
# X402_FACILITATOR_KEYPAIR=[replace,with,64,secret,key,bytes]
# X402_DEVELOPER_KEYPAIR=[replace,with,64,secret,key,bytes]
# X402_RESOURCE_PROVIDER_KEYPAIR=[replace,with,64,secret,key,bytes]

# Optional. Setup creates and remembers a mint when omitted.
# X402_MINT=

# Optional. An explicit config must already exist; its wallet PDA is derived.
# SWIG_WALLET_ADDRESS, when supplied, must match that derived address.
# Setup creates or reuses a generated Swig when no config is supplied.
# SWIG_CONFIG_ADDRESS=
# SWIG_WALLET_ADDRESS=

# Atomic token units charged by the resource provider.
X402_PAYMENT_AMOUNT=1000

# Optional local HTTP port overrides.
# X402_FACILITATOR_PORT=4022
# X402_RESOURCE_SERVER_PORT=4021
