{
  "name": "swig-email-wallet-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun build web/main.js --target=browser --outfile=dist/main.js",
    "start": "node --use-system-ca --env-file=.env.local server.js",
    "setup:agent": "bun ../phantom/scripts/generate-agent.ts",
    "setup:https": "node --env-file=.env.local setup-https.js"
  },
  "dependencies": {
    "@swig-wallet/expo-idp-sdk": "git+https://github.com/anagrambuild/swig-idp-sdk.git#6b3f01d942ee97fbe4e354904a03eb55cb42245c",
    "jose": "^6.1.3"
  }
}
