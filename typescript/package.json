{
  "name": "@swig-wallet/developer-sdk",
  "version": "0.11.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anagrambuild/swig-developer-sdk",
    "directory": "typescript"
  },
  "type": "module",
  "scripts": {
    "build-pkg": "tsup-node",
    "build": "tsup-node",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "dev": "tsup-node --watch",
    "example:x402": "bun --env-file=examples/x402/.env.local run examples/x402/run.ts",
    "example:x402:setup": "bun --env-file=examples/x402/.env.local run examples/x402/setup.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --config eslint.config.mjs --ext js,ts,tsx src",
    "lint:fix": "eslint --config eslint.config.mjs --ext js,ts,tsx src --fix",
    "smoke:local": "bun run scripts/local-transaction-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.x402.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./signers": {
      "types": "./dist/signers.d.ts",
      "import": "./dist/signers.js",
      "require": "./dist/signers.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@swig-wallet/lib": "^2.1.0",
    "@x402/core": "2.21.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.0",
    "@solana/kit": "^5.4.0",
    "@solana/spl-token": "^0.4.13",
    "@types/bun": "^1.2.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@x402/express": "2.21.0",
    "@x402/svm": "2.21.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "express": "^5.2.1",
    "globals": "^16.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.3"
  }
}
