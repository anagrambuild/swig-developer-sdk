{
  "name": "swig-developer-sdk-repository",
  "private": true,
  "type": "module",
  "workspaces": ["typescript"],
  "scripts": {
    "build": "bun run --cwd typescript build",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "format": "prettier --check typescript",
    "format:fix": "prettier --write typescript",
    "lint": "bun run --cwd typescript lint",
    "lint:fix": "bun run --cwd typescript lint:fix",
    "test": "bun run --cwd typescript test",
    "typecheck": "bun run --cwd typescript typecheck"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "typescript": "^5.8.2"
  }
}
